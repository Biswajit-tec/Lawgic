# =============================================================================
# Lawgic — .gitignore
# NEVER commit: secrets, credentials, uploads, database dumps
# =============================================================================

# ─── Secrets & Environment Variables ─────────────────────────────────────────
# CRITICAL: Never commit .env files with real values
.env
.env.local
.env.development
.env.test
.env.staging
.env.production
.env.*.local
!.env.example
!.env.*.example

# ─── Node.js ─────────────────────────────────────────────────────────────────
node_modules/
.pnpm-store/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ─── Build Outputs ────────────────────────────────────────────────────────────
dist/
build/
.next/
out/
.turbo/
*.tsbuildinfo

# ─── Python ───────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv/
.venv/
env/
ENV/
*.egg-info/
dist/
.eggs/
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage
htmlcov/

# ─── Databases ────────────────────────────────────────────────────────────────
# Never commit database dumps or backups
*.sql.gz
*.dump
*.sqlite
*.sqlite3
*.db
/data/
/postgres-data/
/redis-data/

# ─── User Uploads / Documents ─────────────────────────────────────────────────
# CRITICAL: Never commit user-uploaded documents (may contain PII)
uploads/
tmp-uploads/
processed-docs/
*.pdf
*.jpg
*.jpeg
*.png
*.tiff
*.tif

# ─── Logs ─────────────────────────────────────────────────────────────────────
logs/
*.log
npm-debug.log*

# ─── Testing ──────────────────────────────────────────────────────────────────
coverage/
.nyc_output/
test-results/
playwright-report/
playwright/.cache/

# ─── Editor / OS ──────────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
Thumbs.db
.idea/
.vscode/settings.json
*.swp
*.swo
*~

# ─── Docker ───────────────────────────────────────────────────────────────────
docker-compose.override.yml

# ─── Infrastructure / Deployment ──────────────────────────────────────────────
infrastructure/terraform/.terraform/
infrastructure/terraform/*.tfstate
infrastructure/terraform/*.tfstate.backup
infrastructure/terraform/*.tfvars
!infrastructure/terraform/*.tfvars.example

# ─── AWS / Cloud Credentials ──────────────────────────────────────────────────
# CRITICAL: Never commit cloud credentials
.aws/
*.pem
*.key
*.crt
*.p12

# ─── Sentry ───────────────────────────────────────────────────────────────────
.sentryclirc
