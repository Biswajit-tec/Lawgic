# =============================================================================
# LAWgic Environment Variables — EXAMPLE FILE
# Copy this to .env.local (for Next.js) or .env (for API/AI service)
# NEVER commit .env files with real values to Git
# =============================================================================

# =============================================================================
# SHARED — Used by multiple services
# =============================================================================

NODE_ENV=development

# =============================================================================
# NEXT.JS WEB APP (apps/web)
# Variables prefixed with NEXT_PUBLIC_ are exposed to the browser.
# NEVER put secrets in NEXT_PUBLIC_ variables.
# =============================================================================

# Public Supabase config (safe for browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# API URL (public — points to NestJS backend)
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1

# App config
NEXT_PUBLIC_APP_NAME=LAWgic
NEXT_PUBLIC_APP_URL=http://localhost:3000

# =============================================================================
# NESTJS API (apps/api)
# These are SERVER-ONLY — never expose to browser
# =============================================================================

PORT=3001
API_PREFIX=api/v1
CORS_ORIGINS=http://localhost:3000

# PostgreSQL (Supabase free tier for development)
DATABASE_URL=postgresql://postgres:your-password@db.your-project.supabase.co:5432/postgres

# Redis (local Docker for development)
REDIS_URL=redis://localhost:6379

# Supabase Auth
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
# CRITICAL: Service role key is server-only — NEVER expose to browser
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-minimum-32-characters

# AI Service (internal communication)
AI_SERVICE_URL=http://localhost:8001
# Generate a strong random key: openssl rand -hex 32
AI_SERVICE_API_KEY=your-internal-ai-service-api-key-minimum-32-chars

# Storage (local for development)
STORAGE_PROVIDER=local
# For production S3:
# STORAGE_PROVIDER=s3
# AWS_REGION=ap-south-1
# AWS_S3_BUCKET=lawgic-documents-prod
# AWS_ACCESS_KEY_ID=your-access-key
# AWS_SECRET_ACCESS_KEY=your-secret-key

# Observability (optional for development)
SENTRY_DSN=

# =============================================================================
# PYTHON AI SERVICE (apps/ai-service)
# =============================================================================

ENVIRONMENT=development

# Internal API key (must match API's AI_SERVICE_API_KEY)
AI_SERVICE_API_KEY=your-internal-ai-service-api-key-minimum-32-chars

# Database (same as API)
DATABASE_URL=postgresql://postgres:your-password@db.your-project.supabase.co:5432/postgres

# LLM Providers (add keys for providers you want to use)
# Start with Gemini — most cost-effective
GOOGLE_API_KEY=your-google-ai-api-key
# Fallbacks (optional)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Default LLM — change to switch providers without code changes
DEFAULT_LLM_PROVIDER=google_gemini
DEFAULT_LLM_MODEL=gemini-1.5-flash

# Embedding — local model by default (free)
EMBEDDING_PROVIDER=sentence_transformers_local
EMBEDDING_MODEL=intfloat/multilingual-e5-base

# OCR — local Tesseract by default (free for development)
OCR_PROVIDER=tesseract_local
# For production: OCR_PROVIDER=aws_textract

# Translation — local NLLB model by default (free)
TRANSLATION_PROVIDER=local_nllb
# For production with Bhashini:
# TRANSLATION_PROVIDER=bhashini
# BHASHINI_API_KEY=your-bhashini-key
# For Sarvam AI:
# TRANSLATION_PROVIDER=sarvam_ai
# SARVAM_API_KEY=your-sarvam-key

# RAG
RAG_TOP_K=10
RAG_RERANK_ENABLED=false

# =============================================================================
# WORKER (apps/worker)
# =============================================================================

# Redis (same as API)
REDIS_URL=redis://localhost:6379

# Internal AI service
AI_SERVICE_URL=http://localhost:8001
AI_SERVICE_API_KEY=your-internal-ai-service-api-key-minimum-32-chars

# =============================================================================
# NOTES FOR DEVELOPERS
# =============================================================================
#
# 1. Copy this file to .env (for API/worker) or .env.local (for Next.js)
# 2. Never commit .env or .env.local with real values
# 3. For Supabase JWT secret: Dashboard > Settings > API > JWT Settings
# 4. For local Redis: run `docker run -d -p 6379:6379 redis:alpine`
# 5. For Tesseract OCR: install from https://github.com/tesseract-ocr/tesseract
# 6. AI_SERVICE_API_KEY: generate with `openssl rand -hex 32` or similar
# 7. See docs/security/secrets-management.md for production secrets guidance
