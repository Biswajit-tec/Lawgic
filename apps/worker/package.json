{
  "name": "@lawgic/worker",
  "version": "0.1.0",
  "private": true,
  "description": "LAWgic Background Worker — BullMQ job processors for document processing pipeline",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "ts-node-dev --respawn src/main.ts",
    "start": "node dist/main",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/**/*.ts\"",
    "format": "prettier --write \"src/**/*.ts\"",
    "test": "jest",
    "test:ci": "jest --ci --coverage",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "bullmq": "^5.0.0",
    "ioredis": "^5.5.0",
    "zod": "^3.25.0",
    "@lawgic/types": "workspace:*",
    "@lawgic/config": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "rimraf": "^5.0.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.7.0"
  }
}
